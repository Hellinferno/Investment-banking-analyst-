# ---- LLM Providers ----------------------------------------------------------
# At least one key is required. With both configured, the model registry picks
# the primary per purpose and the other acts as automatic fallback.
GEMINI_API_KEY=

# NVIDIA NIM (OpenAI-compatible) — get a key from https://build.nvidia.com
# NEVER commit a real key. This file is a template only.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k2.6
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_TOKENS=16384
NVIDIA_FALLBACK_ENABLED=true
# ---- Environment & dev bootstrap auth --------------------------------------
# AIBAA_ENV must be "production" in any deployed/shared environment. The
# /auth/dev-token endpoint is OPT-IN: it exists ONLY when AIBAA_ENV is
# "development" or "test" AND AIBAA_DEV_BOOTSTRAP_TOKEN below is a strong,
# non-default value (>= 32 chars). It can never mint an admin token.
AIBAA_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave UNSET in production — the dev-token route then returns 404.
AIBAA_DEV_BOOTSTRAP_TOKEN=
AIBAA_DEV_AUTH_ENABLED=true
AIBAA_DEV_ALLOWED_ROLES=analyst,reviewer,admin
# JWT secret MUST be overridden per environment. The app refuses to start in
# production if this is left at the default. Generate a fresh value as above.
AIBAA_JWT_SECRET=aibaa-dev-jwt-secret-change-me
AIBAA_JWT_ALGORITHM=HS256
AIBAA_JWT_ISSUER=aibaa.local
AIBAA_JWT_AUDIENCE=aibaa-api
AIBAA_JWT_EXPIRE_MINUTES=480
AIBAA_DEFAULT_TENANT_ID=org_cyberbank
AIBAA_DEFAULT_USER_ID=usr_proto123
AIBAA_DEFAULT_USER_ROLE=analyst
AIBAA_DEFAULT_USER_EMAIL=demo.user@aibaa.local
AIBAA_REVIEWER_ROLES=reviewer,admin

# ---- SerpAPI (optional — Google news/finance/web search for agents) --------
# Get your API key from https://serpapi.com/dashboard (free tier: 250/month).
# When set, Research and Due Diligence agents enrich automatically; results
# are cached (default 6 h) and a quota reserve is never spent.
# SERPAPI_API_KEY=your_key_here
# SERPAPI_CACHE_TTL_SECONDS=21600
# SERPAPI_QUOTA_RESERVE=20

# ---- TinyFish Web Agent (optional — live web scraping for agents) ----------
# Get your API key from https://agent.tinyfish.ai/api-keys
# Leave empty to disable web enrichment; agents fall back to document-only analysis.
# TINYFISH_API_KEY=your_key_here

# ---- LLM Response Cache -------------------------------------------------------
# In-process SHA-256 keyed cache to avoid redundant Gemini API calls for identical
# (system_prompt, user_prompt) pairs (e.g. same document re-submitted).
# GEMINI_RESPONSE_CACHE_ENABLED=true
# GEMINI_RESPONSE_CACHE_TTL_SECONDS=3600
