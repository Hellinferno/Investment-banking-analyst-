# Copy to apps/api/.env for local development only.
# Never commit real API keys or production secrets.

LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_FINANCIAL_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_DRAFT_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_COORDINATION_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
OPENROUTER_DAILY_REQUEST_LIMIT=40
OPENROUTER_REQUESTS_PER_MINUTE=10
OPENROUTER_MAX_ATTEMPTS=2
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_PROMPT_CHARS=120000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SERPAPI_API_KEY=
AIBAA_RESEARCH_MODE=live
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FINANCIAL_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_TOKENS=4096
NVIDIA_ENABLE_THINKING=false
NVIDIA_DAILY_REQUEST_LIMIT=40
NVIDIA_REQUESTS_PER_MINUTE=10
NVIDIA_MAX_PROMPT_CHARS=120000
NVIDIA_FALLBACK_ENABLED=true
AIBAA_API_BOOTSTRAP_TOKEN=dev-local-token
AIBAA_DEV_AUTH_ENABLED=true
AIBAA_DEV_ALLOWED_ROLES=analyst,reviewer,admin
AIBAA_JWT_SECRET=change-me-in-development
AIBAA_JWT_ALGORITHM=HS256
AIBAA_JWT_ISSUER=aibaa.local
AIBAA_JWT_AUDIENCE=aibaa-api
AIBAA_JWT_EXPIRE_MINUTES=480
AIBAA_DEFAULT_TENANT_ID=org_cyberbank
AIBAA_DEFAULT_USER_ID=usr_proto123
AIBAA_DEFAULT_USER_ROLE=analyst
AIBAA_DEFAULT_USER_EMAIL=demo.user@aibaa.local
AIBAA_REVIEWER_ROLES=reviewer,admin
