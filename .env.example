# =============================================================================
# AIBAA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- LLM API Keys -----------------------------------------------------------
# auto prefers OpenRouter when its key is set; otherwise Gemini, then NVIDIA.
# Explicit selection never falls through to another provider account.
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_FINANCIAL_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_DRAFT_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_COORDINATION_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
OPENROUTER_DAILY_REQUEST_LIMIT=40
OPENROUTER_REQUESTS_PER_MINUTE=10
OPENROUTER_MAX_ATTEMPTS=2
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_PROMPT_CHARS=120000

# Optional direct Google Gemini configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Public Company Search --------------------------------------------------
SERPAPI_API_KEY=
AIBAA_RESEARCH_MODE=live

# Optional direct NVIDIA hosted trial provider (no partner endpoint).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FINANCIAL_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_TOKENS=4096
NVIDIA_ENABLE_THINKING=false
NVIDIA_DAILY_REQUEST_LIMIT=40
NVIDIA_REQUESTS_PER_MINUTE=10
NVIDIA_MAX_PROMPT_CHARS=120000

# ---- Authentication ---------------------------------------------------------
# Generate a secure secret: openssl rand -hex 32
AIBAA_JWT_SECRET=change-me-in-production

# HS256 (default) or RS256 (for JWKS/external IdP)
AIBAA_JWT_ALGORITHM=HS256

# Dev-mode bootstrap token (disabled in production)
AIBAA_DEV_AUTH_ENABLED=true
AIBAA_API_BOOTSTRAP_TOKEN=dev-local-token

# Default tenant and user IDs for dev (multi-tenant will override these)
AIBAA_DEFAULT_TENANT_ID=default-tenant
AIBAA_DEFAULT_USER_ID=default-user
AIBAA_DEFAULT_USER_ROLE=analyst

# ---- Database ---------------------------------------------------------------
# SQLite (default for local dev):
# Local SQLite defaults to apps/data/aibaa.db. Set DATABASE_URL only to override.
# DATABASE_URL=sqlite:///./aibaa.db

# PostgreSQL (for Docker / production):
# DATABASE_URL=postgresql://aibaa:secret@localhost:5432/aibaa

# ---- CORS -------------------------------------------------------------------
AIBAA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ---- Environment ------------------------------------------------------------
AIBAA_ENV=development

# ---- File Upload Limits -----------------------------------------------------
MAX_UPLOAD_MB=150
AIBAA_MAX_PARSED_CHARS=1200000

# ---- LLM Backend Override (for CI/testing) ----------------------------------
# Set AIBAA_RESEARCH_MODE=demo to exercise research UI and exports without keys.
# Demo sources are synthetic and cannot demonstrate live SerpApi functionality.
